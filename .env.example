# Supabase project settings (server-side secrets only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Telegram bot
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=make_a_long_random_secret
TELEGRAM_BOT_USERNAME=YourBotUsernameWithoutAt
# Telegram channel numeric ID, e.g. -1001234567890; bot must be admin
TELEGRAM_DEFAULT_CHANNEL_ID=

# Meta Conversions API (optional until configured)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Protect admin API with a long random value
ADMIN_API_KEY=replace_with_a_long_random_secret
PUBLIC_SITE_URL=https://your-project.vercel.app
